{
  "name": "glue",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build",
    "lint": "eslint",
    "lint:styles": "stylelint \"src/design-system/**/*.scss\"",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "collect-insights": "tsx --env-file-if-exists=.env.local scripts/collect-insights.ts",
    "concept": "tsx --env-file-if-exists=.env.local scripts/concept.ts",
    "measure": "tsx --env-file-if-exists=.env.local scripts/measure.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "@carbon/react": "^1.117.0",
    "@ibm/plex-sans": "^1.1.0",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@xyflow/react": "^12.12.0",
    "drizzle-orm": "^0.45.3",
    "elkjs": "^0.12.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.32.0",
    "unified": "^11.0.5",
    "zod": "^4.6.5",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "culori": "^4.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "1.105.0",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "packageManager": "pnpm@11.0.8",
  "version": "1.27.0"
}
